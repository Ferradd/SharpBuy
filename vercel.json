{
  "version": 2,
  "functions": {
    "api/steam-verify.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/lzma/**"
    },
    "api/account-library.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/lzma/**"
    },
    "api/warranty-check.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/SharpBuy_Launcher.exe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SharpBuy_Launcher.exe\""
        }
      ]
    },
    {
      "source": "/SharpBuy_Launcher.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SharpBuy_Launcher.dmg\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/)(?!.*\\..*$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/arbitrage-cron",
      "schedule": "0 0 * * *"
    }
  ]
}
