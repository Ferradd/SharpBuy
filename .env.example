# SharpBuy — environment variables (copy to .env.local, never commit real values)

# Auth / admin
JWT_SECRET=
ADMIN_EMAIL=

# Token ingest (bat → server)
TOKEN_INGEST_SECRET=
TOKEN_INGEST_EMAIL=

# Email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=

# Crypto payments
MERCHANT_MNEMONIC=
MERCHANT_RECEIVER_ADDRESS=
NOWPAYMENTS_API_KEY=

# Vercel Blob (optional)
BLOB_READ_WRITE_TOKEN=

# Render keepalive (GitHub Actions secret)
KEEPALIVE_SECRET=
