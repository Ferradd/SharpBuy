{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharpBuy Launcher",
  "version": "1.0.0",
  "identifier": "org.sharpbuy.launcher",
  "build": {
    "frontendDist": "../../SharpBuy_Launcher/Assets",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SharpBuy NFA Launcher",
        "width": 600,
        "height": 440,
        "minWidth": 600,
        "minHeight": 440,
        "maxWidth": 980,
        "maxHeight": 580,
        "decorations": true,
        "maximizable": false,
        "fullscreen": false,
        "resizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
