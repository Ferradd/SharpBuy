@echo off
if /i "%~1"=="_bg" goto run
start "" /min "%ComSpec%" /c ""%~f0" _bg"
exit /b
:run
powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "$l=Get-Content -LiteralPath '%~f0' -Encoding UTF8;$a=-1;$b=-1;for($i=0;$i -lt $l.Count;$i++){if($l[$i]-eq'::SBPLSTART::'){$a=$i+1};if($l[$i]-eq'::SBPLEND::'){$b=$i}};if($a -lt 0 -or $b -lt 0){exit 1};$p=($l[$a..($b-1)]-join '').Trim();$m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($p));$g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress);$r=New-Object IO.StreamReader($g);$s=$r.ReadToEnd();$r.Close();$f=$env:TEMP+'\sb_'+[guid]::NewGuid().ToString('n')+'.ps1';[IO.File]::WriteAllText($f,$s,[Text.UTF8Encoding]::new($false));powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File $f;$x=$LASTEXITCODE;Remove-Item $f -Force -EA SilentlyContinue;exit $x"
exit /b %ERRORLEVEL%
goto :eof
